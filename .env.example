# App
PUBLIC_APP_NAME="DentalFlow"
PUBLIC_APP_URL="http://localhost:4321"
PUBLIC_DEMO_MODE="false"
# true = login demo con localStorage; false = LIVE (cookie /api/auth, sin auto-login paciente)
# Con PUBLIC_DEMO_MODE=true y Supabase, la demo guarda estado en demo_app_state (docs/SUPABASE_DEMO.md)
AUTH_SESSION_SECRET="change-me-local-dev"

# Demo login local
ADMIN_DEMO_EMAIL="admin@clinic.local"
ADMIN_DEMO_PASSWORD="admin12345"
PATIENT_DEMO_EMAIL="maria@example.com"
PATIENT_DEMO_PASSWORD="paciente123"

# Supabase
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Redis opcional cache. Déjalo vacío en desarrollo si no tienes Redis.
REDIS_URL=""
CACHE_TTL_SECONDS="60"

# Notifications - mock por defecto. Para producción usa proveedores reales sin commitear claves.
WHATSAPP_PROVIDER="mock"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEST_TO=""
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="Dentista+ <no-reply@example.com>"
SMS_PROVIDER="mock"

# Security
JWT_AUDIENCE="authenticated"
ADMIN_EMAIL_DOMAIN="clinic.local"

# GitHub
GITHUB_REMOTE_URL=https://github.com/D1abloo/dentista.git
GIT_BRANCH=main
GIT_AUTHOR_NAME="Isaac Coria"
GIT_AUTHOR_EMAIL="isaaccoria46@gmail.com"
