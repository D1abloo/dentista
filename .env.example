# App
PUBLIC_APP_NAME="DentalFlow"
PUBLIC_APP_URL="http://localhost:4321"
PUBLIC_DEMO_MODE="false"
# true = SOLO desarrollo local con datos ficticios; false = PRODUCCIÓN (obligatorio en deploy)
AUTH_SESSION_SECRET="change-me-local-dev"

# Super Admin Dentista+ (panel /platform)
SUPER_ADMIN_EMAIL="admin@dentista.app"
SUPER_ADMIN_PASSWORD="cambiar-en-produccion"
SUPER_ADMIN_NAME="Administrador plataforma"

# Contraseña inicial al aprobar registro de clínica (Supabase Auth)
CLINIC_DEFAULT_PASSWORD="cambiar-en-produccion"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Demo login local — ignorado si PUBLIC_DEMO_MODE=false
ADMIN_DEMO_EMAIL="admin@clinic.local"
ADMIN_DEMO_PASSWORD="admin12345"
PATIENT_DEMO_EMAIL="maria@example.com"
PATIENT_DEMO_PASSWORD="paciente123"

# Supabase
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Redis opcional cache. Déjalo vacío en desarrollo si no tienes Redis.
REDIS_URL=""
CACHE_TTL_SECONDS="60"

# Notifications - mock por defecto. Para producción usa proveedores reales sin commitear claves.
WHATSAPP_PROVIDER="mock"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEST_TO=""
# Correo: auto (SMTP si hay credenciales, si no Resend). Valores: auto | smtp | resend | mock
EMAIL_PROVIDER="auto"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@estructuraweb.es"
SMTP_PASS=""
SMTP_FROM="Dentista+ <info@estructuraweb.es>"
CONTACT_NOTIFY_EMAIL="info@estructuraweb.es"
RESEND_API_KEY=""
EMAIL_FROM="Dentista+ <info@estructuraweb.es>"
SMS_PROVIDER="mock"

# Security
JWT_AUDIENCE="authenticated"
ADMIN_EMAIL_DOMAIN="clinic.local"

# GitHub
GITHUB_REMOTE_URL=https://github.com/D1abloo/dentista.git
GIT_BRANCH=main
GIT_AUTHOR_NAME="Isaac Coria"
GIT_AUTHOR_EMAIL="isaaccoria46@gmail.com"
