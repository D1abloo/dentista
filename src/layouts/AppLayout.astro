import '../styles/platform-incidents.css';
import '../styles/platform-isolation.css';
import '../styles/platform-registrations.css';
import '../styles/platform-history.css';
import '../styles/platform-subscriptions.css';
import '../styles/platform-support.css';
import '../styles/platform-metrics.css';
import '../styles/platform-settings.css';
import '../styles/platform-security.css';
import '../styles/platform-audit.css';
import '../styles/platform-monitoring.css';
import '../styles/login-panels.css';
import '../styles/platform-login.css';
import '../styles/clinic-login.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Dentista+',
  description = 'Gestión premium de citas dentales',
  keywords,
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogLocale = 'es_ES',
  twitterCard,
  twitterTitle,
  twitterDescription,
  structuredData
} = Astro.props as Props;

const jsonLd =
  structuredData == null
    ? null
    : Array.isArray(structuredData)
      ? structuredData
      : [structuredData];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#168a94" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:opsz,wght@9..40,400;500;600;700&family=Fraunces:opsz,wght@9..144,500;600&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {twitterCard ? <meta name="twitter:card" content={twitterCard} /> : null}
    {twitterTitle ? <meta name="twitter:title" content={twitterTitle} /> : null}
    {twitterDescription ? <meta name="twitter:description" content={twitterDescription} /> : null}
    {jsonLd?.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
