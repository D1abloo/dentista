import '../styles/patient-consents.css';
import '../styles/patient-profile.css';
import '../styles/patient-portal-unified.css';
import '../styles/admin-clinical-ops.css';
import '../styles/public-front.css';
import '../styles/public-site.css';
import '../styles/patient-portal-public.css';
import '../styles/landing-pro.css';
import '../styles/landing-premium.css';
import '../styles/admin-dashboard.css';
import '../styles/admin-agenda.css';
import '../styles/admin-patients.css';
import '../styles/admin-documents.css';
import '../styles/admin-invoices.css';
import '../styles/admin-payments.css';
import '../styles/admin-reports.css';
import '../styles/admin-clinical-reports.css';
import '../styles/admin-settings.css';
import '../styles/admin-notifications.css';
import '../styles/admin-layout.css';
import '../styles/platform-overview.css';
import '../styles/platform-organizations.css';
import '../styles/platform-clinics.css';
import '../styles/platform-users.css';
import '../styles/platform-incidents.css';
import '../styles/platform-isolation.css';
import '../styles/platform-registrations.css';
import '../styles/platform-history.css';
import '../styles/platform-subscriptions.css';
import '../styles/platform-support.css';
import '../styles/platform-metrics.css';
import '../styles/platform-settings.css';
import '../styles/platform-security.css';
import '../styles/platform-audit.css';
import '../styles/platform-monitoring.css';
import '../styles/login-panels.css';
import '../styles/platform-login.css';
import '../styles/clinic-login.css';
import { AiBookingWidget } from '@/components/public/AiBookingWidget';
import {
  BRAND_SEO,
  defaultOgImage,
  isPrivatePath,
  resolveCanonical
} from '@/lib/seo/siteConfig';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  ogImage?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props as Props;
const pathname = Astro.url.pathname;
const isPrivate = isPrivatePath(pathname);
const shouldNoindex = props.noindex === true || isPrivate;

const title = props.title ?? BRAND_SEO.defaultTitle;
const description = props.description ?? BRAND_SEO.defaultDescription;
const keywords = props.keywords ?? BRAND_SEO.defaultKeywords;
const ogTitle = props.ogTitle ?? title;
const ogDescription = props.ogDescription ?? description;
const ogType = props.ogType ?? 'website';
const ogLocale = props.ogLocale ?? 'es_ES';
const ogImage = props.ogImage ?? defaultOgImage();
const twitterCard = props.twitterCard ?? 'summary_large_image';
const twitterTitle = props.twitterTitle ?? ogTitle;
const twitterDescription = props.twitterDescription ?? ogDescription;
const twitterImage = props.twitterImage ?? ogImage;

const robots =
  props.robots ??
  (shouldNoindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1');

const canonicalHref =
  props.canonical ?? (shouldNoindex ? undefined : resolveCanonical(pathname));
const pageUrl = canonicalHref ?? resolveCanonical(pathname);

const jsonLd =
  props.structuredData == null
    ? null
    : Array.isArray(props.structuredData)
      ? props.structuredData
      : [props.structuredData];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content={BRAND_SEO.name} />
    <meta name="generator" content="Astro" />
    {canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
    <link rel="alternate" hreflang="es" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <meta name="theme-color" content="#168a94" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:opsz,wght@9..40,400;500;600;700&family=Fraunces:opsz,wght@9..144,500;600&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:site_name" content={BRAND_SEO.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Captura del panel ${BRAND_SEO.name} para clínicas dentales`} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={twitterImage} />
    {jsonLd?.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <slot />
    {!isPrivate ? <AiBookingWidget client:load /> : null}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
