---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { ClinicRegistrationPage } from '@/components/DentistaApp';
import { publicBreadcrumb } from '@/lib/seo/breadcrumbs';
import { seoLayoutProps } from '@/lib/seo/layoutProps';

const seo = seoLayoutProps('/registro-clinica');
---
<PublicLayout {...seo} structuredData={publicBreadcrumb({ name: 'Registro clínica', path: '/registro-clinica' })}>
  <ClinicRegistrationPage client:load />
</PublicLayout>
