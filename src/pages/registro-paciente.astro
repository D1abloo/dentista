---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { PatientRegistrationPage } from '@/components/auth/PatientRegistrationPage';
import { publicBreadcrumb } from '@/lib/seo/breadcrumbs';
import { seoLayoutProps } from '@/lib/seo/layoutProps';

const seo = seoLayoutProps('/registro-paciente');
---
<PublicLayout {...seo} structuredData={publicBreadcrumb({ name: 'Registro paciente', path: '/registro-paciente' })}>
  <PatientRegistrationPage client:load />
</PublicLayout>
