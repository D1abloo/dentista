---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { ContactPage } from '@/components/DentistaApp';
import { publicBreadcrumb } from '@/lib/seo/breadcrumbs';
import { seoLayoutProps } from '@/lib/seo/layoutProps';

const seo = seoLayoutProps('/contacto');
---
<PublicLayout {...seo} structuredData={publicBreadcrumb({ name: 'Contacto', path: '/contacto' })}>
  <ContactPage client:load />
</PublicLayout>
