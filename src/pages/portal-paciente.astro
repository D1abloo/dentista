---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { PatientPortalPublicPage } from '@/components/public/PatientPortalPublicPage';
import { publicBreadcrumb } from '@/lib/seo/breadcrumbs';
import { seoLayoutProps } from '@/lib/seo/layoutProps';

const seo = seoLayoutProps('/portal-paciente');
---
<PublicLayout {...seo} structuredData={publicBreadcrumb({ name: 'Portal paciente', path: '/portal-paciente' })}>
  <PatientPortalPublicPage client:load />
</PublicLayout>
