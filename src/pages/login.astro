---
import AppLayout from '@/layouts/AppLayout.astro';
import { DEMO_TENANTS } from '@/lib/tenantIds';

const isDemo = import.meta.env.PUBLIC_DEMO_MODE === 'true';
---
<AppLayout title="Elegir portal · Dentista+">
  {!isDemo ? (
    <script is:inline>
      ['dentista_role', 'dentista_patient_id', 'dentista_tenant_id', 'dentista_ephemeral', 'dentista_demo_v4'].forEach(
        (k) => localStorage.removeItem(k)
      );
    </script>
  ) : null}
  <script is:inline>
    (function () {
      const p = new URLSearchParams(location.search);
      const role = p.get('role');
      if (role === 'admin') {
        const tenant = p.get('tenant');
        location.replace(tenant ? '/login/admin?tenant=' + encodeURIComponent(tenant) : '/login/admin');
        return;
      }
      if (role === 'paciente') {
        location.replace('/login/paciente');
      }
    })();
  </script>
  <main class="grid min-h-screen place-items-center bg-[var(--bg)] px-4 py-12">
    <div class="w-full max-w-md rounded-2xl border border-[var(--line)] bg-white p-8 shadow-[var(--shadow-lg)]">
      <div class="flex flex-col items-center text-center">
        <img src="/icons/icon-192.svg" alt="" width="52" height="52" class="rounded-xl" />
        <h1 class="mt-4 font-[family-name:var(--display)] text-2xl text-[var(--navy)]">Elegir portal</h1>
        <p class="mt-2 text-sm text-[var(--muted)]">
          {isDemo
            ? 'Modo demo: elige portal (sin inicio automático).'
            : 'Modo LIVE: elige portal e inicia sesión con email y contraseña.'}
        </p>
      </div>

      <a
        href="/login/admin"
        class="mt-8 flex flex-col rounded-2xl border border-blue-200 bg-blue-50 p-5 no-underline transition hover:border-blue-300"
      >
        <span class="text-xs font-bold uppercase tracking-wide text-blue-800">Panel clínica</span>
        <span class="mt-1 text-sm text-blue-950">
          Administrador · {DEMO_TENANTS.map((t) => t.label).join(', ')}
        </span>
        <span class="mt-3 text-sm font-semibold text-blue-800">Continuar como administración →</span>
      </a>

      <a
        href="/login/paciente"
        class="mt-4 flex flex-col rounded-2xl border border-teal-200 bg-teal-50 p-5 no-underline transition hover:border-teal-300"
      >
        <span class="text-xs font-bold uppercase tracking-wide text-teal-800">Portal paciente</span>
        <span class="mt-1 font-[family-name:var(--display)] text-lg text-[var(--navy)]">Elena Vidal Romero</span>
        <span class="mt-1 font-mono text-xs text-teal-900">PAT-0001</span>
        <span class="mt-3 text-sm font-semibold text-teal-800">Continuar como paciente →</span>
      </a>

      <p class="mt-6 text-center text-xs text-[var(--muted)]">
        <a href="/" class="font-semibold text-[var(--blue)] underline">Volver al inicio</a>
      </p>
    </div>
  </main>
</AppLayout>
