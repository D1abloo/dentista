---
import PublicLayout from '@/layouts/PublicLayout.astro'
import { CitasConIaPage } from '@/components/public/citas-con-ia/CitasConIaPage'
import { aiAssistantWebAppLd, publicBreadcrumb } from '@/lib/seo/breadcrumbs'
import { seoLayoutProps } from '@/lib/seo/layoutProps'

const seo = seoLayoutProps('/citas-con-ia')
---
<PublicLayout {...seo} structuredData={[publicBreadcrumb({ name: 'Citas con IA', path: '/citas-con-ia' }), aiAssistantWebAppLd]}>
  <CitasConIaPage client:load />
</PublicLayout>
