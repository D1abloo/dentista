---
import AppLayout from '@/layouts/AppLayout.astro';
import { LegalPage } from '@/components/public/LegalPage';
import { cookiesSections } from '@/lib/legal/content';
import { seoLayoutProps } from '@/lib/seo/layoutProps';

const seo = seoLayoutProps('/cookies');
---
<AppLayout {...seo}>
  <LegalPage
    client:load
    title="Política de cookies"
    intro="Detalle de las cookies y tecnologías similares que utilizamos, cómo gestionarlas y qué ocurre según tu elección en el banner."
    sections={cookiesSections}
  />
</AppLayout>
