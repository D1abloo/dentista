{
  "name": "Appointment Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointments",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "appointments"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst required = ['userId', 'companyId', 'message', 'channel'];\nfor (const key of required) {\n  if (!body[key]) throw new Error(`Campo obligatorio: ${key}`);\n}\nreturn [{ json: { ...body, timezone: body.timezone || 'Europe/Madrid' } }];"
      },
      "id": "validate-payload",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/ai/appointments-chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"message\": $json.message, \"conversation\": [], \"assistantState\": {\"bookingState\": {\"clinicId\": $json.companyId}, \"assistantContext\": {\"mode\": \"book\", \"verificationToken\": $json.metadata?.verificationToken}}}"
      },
      "id": "detect-intent",
      "name": "Detect Intent (Gemini via backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "notes": "Opcional: sustituir por nodo OpenAI/Gemini directo. El backend ya interpreta intención si se usa /api/appointments/intent."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.data?.intent?.intent || $json.intent}}",
                    "rightValue": "check_availability",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "availability"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.data?.intent?.intent || $json.intent}}",
                    "rightValue": "create_appointment",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "create"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.data?.intent?.intent || $json.intent}}",
                    "rightValue": "get_appointments",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "list"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.data?.intent?.intent || $json.intent}}",
                    "rightValue": "cancel_appointment",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "cancel"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.data?.intent?.intent || $json.intent}}",
                    "rightValue": "reschedule_appointment",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reschedule"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-intent",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.APP_BASE_URL}}/api/appointments/availability",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "clinicId", "value": "={{$('Validate Payload').item.json.companyId}}" },
            { "name": "treatmentId", "value": "={{$json.treatmentId}}" },
            { "name": "fromDate", "value": "={{$json.date}}" },
            { "name": "toDate", "value": "={{$json.date}}" },
            { "name": "time", "value": "={{$json.time}}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.N8N_SERVICE_TOKEN}}" },
            { "name": "x-automation-user-id", "value": "={{$('Validate Payload').item.json.userId}}" },
            { "name": "x-automation-company-id", "value": "={{$('Validate Payload').item.json.companyId}}" },
            { "name": "x-automation-channel", "value": "={{$('Validate Payload').item.json.channel}}" }
          ]
        }
      },
      "id": "get-availability",
      "name": "GET Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, -160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/appointments/audit-log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.N8N_SERVICE_TOKEN}}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"clinicId\": $('Validate Payload').item.json.companyId, \"action\": \"workflow.completed\", \"channel\": $('Validate Payload').item.json.channel, \"workflow\": \"Appointment Automation\", \"message\": \"Automatización finalizada\"}"
      },
      "id": "audit-log",
      "name": "Audit Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"data\": {\"reply\": $json.data?.assistantMessage || $json.reply || 'He procesado tu solicitud.', \"intent\": $json.intent, \"needsConfirmation\": $json.needsConfirmation || false, \"data\": $json.data || {}}, \"error\": null, \"meta\": {}}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1460, 0]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Validate Payload", "type": "main", "index": 0 }]]
    },
    "Validate Payload": {
      "main": [[{ "node": "Detect Intent (Gemini via backend)", "type": "main", "index": 0 }]]
    },
    "Detect Intent (Gemini via backend)": {
      "main": [[{ "node": "Route Intent", "type": "main", "index": 0 }]]
    },
    "Route Intent": {
      "main": [
        [{ "node": "GET Availability", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }]
      ]
    },
    "GET Availability": {
      "main": [[{ "node": "Audit Log", "type": "main", "index": 0 }]]
    },
    "Audit Log": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
